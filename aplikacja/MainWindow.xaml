<Window x:Class="App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF 2D Game" Height="600" Width="800"
        KeyDown="MainWindow_KeyDown"
        WindowState="Maximized">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel x:Name="Top_Panel" Visibility="Hidden" Orientation="Horizontal" Margin="10" Cursor="">
            <Button x:Name="Btn_Menu" Width="100" Height="50" Foreground="White" Background="Black" Content="Menu" Click="Btn_Menu_Click" Cursor="Hand" FontWeight="Bold"/>
            <StackPanel>
                <Label Name="WoodLabel" Content="Wood: 0" FontSize="16" Height="44"/>
                <Label x:Name="StoneLabel" Content="Stone: 0" FontSize="16" Height="32" Padding="8,5,5,5"/>
            </StackPanel>
            <Image x:Name="image" Height="100" Width="100" Source="pack://application:,,,/player.png"/>
        </StackPanel>
        <!-- Kontener wyświetlający mapę -->
        <Grid Visibility="Hidden" Name="Grid" HorizontalAlignment="Stretch" Width="Auto"  Grid.Row="1" Background="LightGray">
            <Grid Visibility="Hidden" Name="MapGrid" HorizontalAlignment="Center" Grid.Row="1" Background="LightGray"/>
        </Grid>
        <GroupBox Visibility="Visible" Header="Menu" x:Name="Panel_Menu"  Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Height="300" Width="200" BorderThickness="1" BorderBrush="Black">
            <StackPanel>
                <TextBlock Padding="10" TextAlignment="Center" Text="Choose map:" FontWeight="Bold"></TextBlock>
                <TextBlock Padding="10" TextAlignment="Center" Text="Map 5x5"></TextBlock>
                <Button Background="Black" Foreground="White" x:Name="Map1" Content="Choose" Height="20" Width="100" Click="Map1_Click" Cursor="Hand" FontWeight="Bold"/>
                <TextBlock Padding="10" TextAlignment="Center" Text="Map 6x6"></TextBlock>
                <Button Background="Black" Foreground="White"  x:Name="Map2" Content="Choose" Height="20" Width="100" Click="Map2_Click" Cursor="Hand" FontWeight="Bold"/>
                <TextBlock Padding="10" TextAlignment="Center" Text="Map 8x8"></TextBlock>
                <Button Background="Black" Foreground="White"  x:Name="Map3" Content="Choose" Height="20" Width="100" Click="Map3_Click" Cursor="Hand" FontWeight="Bold"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Visibility="Hidden" Header="Menu" x:Name="Panel_Wybor"  Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Height="300" Width="200" BorderThickness="1" BorderBrush="Black">
            <StackPanel>
                <TextBlock Padding="10" TextAlignment="Center" Text="Resume game:" FontWeight="Bold"></TextBlock>
                <Button Background="Black" Foreground="White" x:Name="Resume" Content="Resume" Height="20" Width="100" Click="Resume_Click" Cursor="Hand" FontWeight="Bold"/>
                <TextBlock Padding="10" TextAlignment="Center" Text="Change map:" FontWeight="Bold"></TextBlock>
                <Button Background="Black" Foreground="White"  x:Name="Map_Change" Content="Change" Height="20" Width="100" Click="Map_Change_Click" Cursor="Hand" FontWeight="Bold"/>
                <TextBlock Padding="10" TextAlignment="Center" Text="Controll" FontWeight="Bold"></TextBlock>
                <Button Background="Black" Foreground="White"  x:Name="Controll" Content="Controll" Height="20" Width="100" Click="Control_Click" Cursor="Hand" FontWeight="Bold"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Visibility="Hidden" Header="Menu" x:Name="Panel_Menu2"  Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Height="300" Width="200" BorderThickness="1" BorderBrush="Black" Cursor="">
            <StackPanel>
                <TextBlock Padding="10" TextAlignment="Center" Text="Choose map:"></TextBlock>
                <TextBlock Padding="10" TextAlignment="Center" Text="Map 5x5"></TextBlock>
                <Button Background="Black" Foreground="White" x:Name="Panel_Menu2_Map1" Content="Change" Height="20" Width="100" Click="Map1_Click" Cursor="Hand"/>
                <TextBlock Padding="10" TextAlignment="Center" Text="Map 6x6"></TextBlock>
                <Button Background="Black" Foreground="White"  x:Name="Panel_Menu2_Map2" Content="Change" Height="20" Width="100" Click="Map2_Click" Cursor="Hand"/>
                <TextBlock Padding="10" TextAlignment="Center" Text="Map 8x8"></TextBlock>
                <Button Background="Black" Foreground="White"  x:Name="Panel_Menu2_Map3" Content="Change" Height="20" Width="100" Click="Map3_Click" Cursor="Hand"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Visibility="Hidden" Header="Menu" x:Name="Panel_Sterowanie"  Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Height="300" Width="200" BorderThickness="1" BorderBrush="Black">
            <StackPanel>
                <Button Background="Black" Foreground="White" Margin="20"  x:Name="Moving" Content="Moving" Height="20" Width="100" Click="Moving_Click" Cursor="Hand" FontWeight="Bold"/>
                <Button Background="Black" Foreground="White" Margin="20"  x:Name="Put" Content="Setting and breaking" Height="20" Width="125" Click="Put_Click" Cursor="Hand" FontWeight="Bold"/>
                <Button Background="Black" Foreground="White" Margin="20"  x:Name="BackToGame" Content="Back" Height="20" Width="125" Cursor="Hand" Click="Back_Click" FontWeight="Bold"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
